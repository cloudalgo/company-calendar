---
import { calendar, hoursLabel } from "../lib/calendar";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="wrap">
  <header class="site-header">
    <a class="logo" href="#top"><img src={`${base}/logo.svg`} alt="CloudAlgo" width="209" height="38" /></a>
    <nav aria-label="Sections">
      <a aria-current="page" href="#top">Calendar</a>
      <a href="#month">Month view</a>
      <a href="#ledger">All dates</a>
      <a href="#band">Contact during closures</a>
    </nav>
    <div class="ctas">
      <a class="btn hdr-ics" href={`${base}/calendar.ics`}>Add to my calendar</a>
      <a class="btn btn-primary" href={calendar.scheduleMeeting}>Book a meeting</a>
    </div>
  </header>

  <div class="aud">
    <span class="mono" id="today-label"></span>
    <span class="mono hours">Office hours {hoursLabel()} IST, Monday to Friday</span>
  </div>
</div>

<style>
  .site-header { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 18px; }
  .ctas { display: flex; gap: 12px; }
  .ctas .btn { white-space: nowrap; }
  .logo img { height: 38px; width: auto; display: block; }
  nav { display: flex; gap: 32px; font-weight: 600; font-size: 0.94rem; color: var(--ink-500); }
  nav a { text-decoration: none; }
  nav a[aria-current] { color: var(--ink-900); box-shadow: inset 0 -2px 0 var(--accent-500); }

  .aud { display: flex; align-items: center; justify-content: space-between; gap: 8px 24px; flex-wrap: wrap; padding: 12px 0; border-top: var(--rule); border-bottom: var(--rule); font-size: .8rem; color: var(--ink-400); }
  #today-label { color: var(--ink-900); }

  @media (max-width: 760px) {
    nav { display: none; }
    .hdr-ics { display: none; }
    .ctas .btn { padding: 10px 14px; }
    .hours { display: none; }
  }
  @media (max-width: 420px) {
    .site-header { gap: 12px; }
    .logo img { height: 30px; }
  }
</style>
