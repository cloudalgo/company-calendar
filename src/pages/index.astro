---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import ClosureStrip from "../components/ClosureStrip.astro";
import MonthView from "../components/MonthView.astro";
import ClosureLedger from "../components/ClosureLedger.astro";
import ContactBand from "../components/ContactBand.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { DAYS, YEAR, calendar, closures } from "../lib/calendar";

const title = `CloudAlgo Holiday Calendar ${YEAR}: Office Closed Days`;
const site = Astro.site ?? new URL("https://cloudalgo.github.io");
const url = new URL(Astro.url.pathname, site).href;
const org = "https://cloudalgo.com/#organization";
const { start, end } = calendar.hours;

// Name as many of the holidays as fit in a search snippet (about 160 characters)
const lead = `CloudAlgo's office is closed on ${closures.length} weekdays in ${YEAR}`;
const tail = `. Open Mon–Fri, ${start}–${end} IST.`;
const names: string[] = [];
for (const c of closures) {
  if (`${lead}, including ${[...names, c.name].join(", ")}${tail}`.length > 160) break;
  names.push(c.name);
}
const description = names.length ? `${lead}, including ${names.join(", ")}${tail}` : `${lead}${tail}`;

// Holidays are closures of the office, so they're marked up as special opening hours, not events
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": org,
      name: "CloudAlgo",
      url: "https://cloudalgo.com/",
      logo: "https://cloudalgo.com/logo.svg",
      email: "sales@cloudalgo.com",
      address: { "@type": "PostalAddress", addressLocality: "Jaipur", addressRegion: "Rajasthan", addressCountry: "IN" },
      sameAs: ["https://www.linkedin.com/company/cloudalgo", "https://github.com/cloudalgo", "https://twitter.com/cloudalgo"],
    },
    {
      "@type": "ProfessionalService",
      "@id": `${url}#office`,
      name: "CloudAlgo",
      url: "https://cloudalgo.com/",
      image: new URL("og-calendar.jpg", url).href,
      email: calendar.contact,
      parentOrganization: { "@id": org },
      address: { "@type": "PostalAddress", addressLocality: "Jaipur", addressRegion: "Rajasthan", addressCountry: "IN" },
      openingHoursSpecification: {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: calendar.workweek.map((d) => `https://schema.org/${DAYS[d]}`),
        opens: start,
        closes: end,
      },
      specialOpeningHoursSpecification: closures.map((c) => ({
        "@type": "OpeningHoursSpecification",
        name: c.name,
        validFrom: c.date,
        validThrough: c.date,
        opens: "00:00",
        closes: "00:00",
      })),
    },
    {
      "@type": "WebPage",
      "@id": `${url}#webpage`,
      url,
      name: title,
      description,
      inLanguage: "en-IN",
      isPartOf: { "@type": "WebSite", url: "https://cloudalgo.com/", name: "CloudAlgo", publisher: { "@id": org } },
      publisher: { "@id": org },
      about: { "@id": `${url}#office` },
      primaryImageOfPage: new URL("og-calendar.jpg", url).href,
    },
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <SiteHeader />
  <main>
    <Hero />
    <ClosureStrip />
    <MonthView />
    <ClosureLedger />
  </main>
  <ContactBand />
  <SiteFooter />
</Base>

<script>
  import "../scripts/calendar.ts";
</script>
